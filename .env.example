# The local launcher loads .env for both the API and worker.
# It keeps local/synthetic mode. Credential is the production access mode.
UNDERSTOOD_TIER=local
UNDERSTOOD_AI_MODE=synthetic
UNDERSTOOD_ACCESS_MODE=credential
UNDERSTOOD_PUBLIC_ORIGIN=http://127.0.0.1:3020
UNDERSTOOD_DB=data/understood.sqlite

# PostgreSQL migration runner only; the web repository is still SQLite-backed.
# Supply these privately when an isolated database is available.
UNDERSTOOD_POSTGRES_URL=
UNDERSTOOD_POSTGRES_TLS=true
UNDERSTOOD_POSTGRES_SCHEMA=public
UNDERSTOOD_POSTGRES_CA_FILE=

# R2 adapter config is passed server-side, not automatically enabled by this file.
# Keep r2.dev and all public custom domains DISABLED on the audio bucket.
UNDERSTOOD_R2_ACCOUNT_ID=
UNDERSTOOD_R2_BUCKET=
UNDERSTOOD_R2_JURISDICTION=default
UNDERSTOOD_R2_ACCESS_KEY_ID=
UNDERSTOOD_R2_SECRET_ACCESS_KEY=

# Gemini adapter accepts only explicitly declared synthetic data.
# No real worker content is permitted on the free tier.
GEMINI_API_KEY=

# Explicit opt-in for a LOCAL, credential-mode, synthetic-data rehearsal only.
# Default remains disabled; even a configured key alone cannot enable uploads.
# Populate the JSON array ONLY with hashes of known synthetic canonical WAV files.
# Do not register real recordings. No browser input can change this allowlist.
UNDERSTOOD_SOURCE_TRANSCRIPTION=disabled
UNDERSTOOD_SYNTHETIC_AUDIO_HASHES=[]
UNDERSTOOD_DATA_CLASS=synthetic

# PostgreSQL LOCAL credential rehearsal follow-ups, disabled by default.
# Explicit gemini mode needs persisted global and tenant provider quotas enabled.
# Never connect this synthetic-only rehearsal to real worker records.
UNDERSTOOD_CASE_FOLLOWUP_ADAPTER=disabled

# LOCAL synthetic recorded answers only, also gated by the WAV hash allowlist
# and persisted global/tenant request quotas. A key alone never enables it.
UNDERSTOOD_RECORDING_ADAPTER=disabled

# Complete synthetic draft input (including edits/glossary/targets) fingerprint.
UNDERSTOOD_PREPARATION_ADAPTER=disabled
UNDERSTOOD_SYNTHETIC_PREPARATION_HASHES=[]

# Exact synthetic typed answer + frozen publication/question/rubric fingerprint.
UNDERSTOOD_ASSESSMENT_ADAPTER=disabled
UNDERSTOOD_SYNTHETIC_ASSESSMENT_HASHES=[]

# Email is OFF by default. No account, verified sender or delivery is configured.
# An operator must authorize delivery before setting mode=resend.
# Keep the 32-byte hexadecimal AUTH_MAIL_KEY stable and private on web and worker.
UNDERSTOOD_EMAIL_MODE=disabled
UNDERSTOOD_RESEND_KEY=
UNDERSTOOD_EMAIL_FROM=
UNDERSTOOD_AUTH_MAIL_KEY=
# Optional private pilot-request destination. Empty means saved only, never sent.
UNDERSTOOD_PILOT_TO=

# Separate operator access for an explicitly isolated PostgreSQL rehearsal.
# No default operator exists; customer owners and demo profiles do not qualify.
UNDERSTOOD_OPERATOR_ACCESS=false

# Explicit one-request fixed synthetic operator connection test, OFF by default.
# PostgreSQL persisted global quota must also be enabled; keys stay server-side.
# Source jobs additionally need a tenant quota and the synthetic WAV allowlist.
UNDERSTOOD_PROVIDER_TESTS=disabled

# Optional PostgreSQL rehearsal synthetic storage health probe, OFF by default.
UNDERSTOOD_STORAGE_CHECKS=false
