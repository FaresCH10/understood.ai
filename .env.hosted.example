# Not deployed. This mode is synthetic staging, NOT permission for real data.
UNDERSTOOD_TIER=staging
UNDERSTOOD_AI_MODE=synthetic
UNDERSTOOD_ACCESS_MODE=credential
UNDERSTOOD_DATA_CLASS=synthetic
UNDERSTOOD_PUBLIC_ORIGIN=https://understood.example.test
PORT=10000
UNDERSTOOD_POSTGRES_SCHEMA=understood_stage_synthetic
# Neon Free only; do not upgrade or provision paid PostgreSQL automatically.
# API and worker must have separate restricted login URLs, never the owner URL.
# This is one service's env contract: use application ACLs for the API and
# --profile=worker ACLs for the worker. Do not share the API login with the worker.
# Configure/check ACLs with scripts/postgres-permissions.mjs before startup.
UNDERSTOOD_POSTGRES_URL=
UNDERSTOOD_POSTGRES_TLS=true
UNDERSTOOD_POSTGRES_CA_FILE=
# Set exact deployment proxy IPs/CIDRs, JSON array. Empty fails startup.
# Proxy must overwrite Host, X-Forwarded-Proto and X-Forwarded-For (one client IP).
# Backend port must NOT be directly reachable from the public internet.
UNDERSTOOD_TRUSTED_PROXY_NETWORKS=[]
# Explicit server-only adapter choice; test settings never auto-enable storage.
UNDERSTOOD_STORAGE_ADAPTER=neon
UNDERSTOOD_NEON_STORAGE_ENDPOINT=
UNDERSTOOD_NEON_STORAGE_REGION=eu-central-1
UNDERSTOOD_NEON_STORAGE_BUCKET=
UNDERSTOOD_NEON_STORAGE_ACCESS_KEY_ID=
UNDERSTOOD_NEON_STORAGE_SECRET_ACCESS_KEY=
# Optional legacy R2 configuration only when STORAGE_ADAPTER=r2; no subscription
# or billing setup is required/requested for the selected Neon Free stack.
UNDERSTOOD_R2_ACCOUNT_ID=
UNDERSTOOD_R2_BUCKET=
UNDERSTOOD_R2_JURISDICTION=eu
UNDERSTOOD_R2_ACCESS_KEY_ID=
UNDERSTOOD_R2_SECRET_ACCESS_KEY=
UNDERSTOOD_STORAGE_CHECKS=false
# Must stay false for customer API and worker services. Use a distinct operator
# login/origin and .env.operator.example for the separate synthetic service.
UNDERSTOOD_OPERATOR_ACCESS=false
UNDERSTOOD_SOURCE_TRANSCRIPTION=disabled
UNDERSTOOD_PROVIDER_TESTS=disabled
UNDERSTOOD_CASE_FOLLOWUP_ADAPTER=disabled
UNDERSTOOD_RECORDING_ADAPTER=disabled
UNDERSTOOD_PREPARATION_ADAPTER=disabled
UNDERSTOOD_ASSESSMENT_ADAPTER=disabled
UNDERSTOOD_EMAIL_MODE=disabled
UNDERSTOOD_RESEND_KEY=
UNDERSTOOD_EMAIL_FROM=
UNDERSTOOD_AUTH_MAIL_KEY=
UNDERSTOOD_PILOT_TO=

# Company registration verification (separate from invitation/recovery mail).
UNDERSTOOD_REGISTRATION_PROVIDER=neon
UNDERSTOOD_NEON_AUTH_URL=
