# Separate synthetic operator service only. Do not reuse customer/worker secrets.
UNDERSTOOD_TIER=staging
UNDERSTOOD_AI_MODE=synthetic
UNDERSTOOD_ACCESS_MODE=credential
UNDERSTOOD_DATA_CLASS=synthetic
UNDERSTOOD_PUBLIC_ORIGIN=https://operations.example.test
UNDERSTOOD_CUSTOMER_ORIGIN=https://understood.example.test
# Must match the customer API/worker schema; the operator reads that staging data.
UNDERSTOOD_POSTGRES_SCHEMA=understood_stage_synthetic
# Dedicated operator LOGIN, never the API/worker/maintenance identity.
UNDERSTOOD_POSTGRES_URL=
UNDERSTOOD_POSTGRES_TLS=true
UNDERSTOOD_TRUSTED_PROXY_NETWORKS=[]
UNDERSTOOD_OPERATOR_ACCESS=true
PORT=10001
