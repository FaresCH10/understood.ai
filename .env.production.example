# API configuration. Keep the Gemini key exclusively in the worker overlay.
UNDERSTOOD_TIER=production
UNDERSTOOD_AI_MODE=live
UNDERSTOOD_ACCESS_MODE=credential
UNDERSTOOD_DATA_CLASS=real
UNDERSTOOD_PUBLIC_ORIGIN=
UNDERSTOOD_POSTGRES_SCHEMA=understood_prod_customer
UNDERSTOOD_POSTGRES_URL=
UNDERSTOOD_POSTGRES_TLS=true
UNDERSTOOD_POSTGRES_CA_FILE=/run/understood/postgres-ca.pem
# On Vercel, set UNDERSTOOD_POSTGRES_CA_PEM to the reviewed CA certificate chain
# and omit UNDERSTOOD_POSTGRES_CA_FILE. The worker continues to use its mounted CA file.
UNDERSTOOD_POSTGRES_ROLE_PROFILE=application
UNDERSTOOD_TRUSTED_PROXY_NETWORKS=["172.30.0.10/32"]
UNDERSTOOD_STORAGE_ADAPTER=neon
UNDERSTOOD_STORAGE_CHECKS=true
UNDERSTOOD_NEON_STORAGE_ENDPOINT=
UNDERSTOOD_NEON_STORAGE_REGION=
UNDERSTOOD_NEON_STORAGE_BUCKET=
UNDERSTOOD_NEON_STORAGE_ACCESS_KEY_ID=
UNDERSTOOD_NEON_STORAGE_SECRET_ACCESS_KEY=
UNDERSTOOD_EMAIL_MODE=resend
UNDERSTOOD_EMAIL_FROM=
UNDERSTOOD_RESEND_KEY=
UNDERSTOOD_AUTH_MAIL_KEY=
UNDERSTOOD_PUSH_ADAPTER=webpush
UNDERSTOOD_PUSH_VAPID_PUBLIC_KEY=
UNDERSTOOD_PUSH_VAPID_PRIVATE_KEY=
UNDERSTOOD_PUSH_VAPID_SUBJECT=
UNDERSTOOD_SOURCE_TRANSCRIPTION=gemini-approved-v1
UNDERSTOOD_PREPARATION_ADAPTER=gemini-deepl-approved-v1
UNDERSTOOD_SPEECH_ADAPTER=gemini-approved-v1
UNDERSTOOD_ASSESSMENT_ADAPTER=gemini-approved-v1
UNDERSTOOD_RECORDING_ADAPTER=gemini-approved-v1
UNDERSTOOD_CASE_FOLLOWUP_ADAPTER=gemini-deepl-approved-v1
UNDERSTOOD_PROVIDER_FALLBACK=disabled
UNDERSTOOD_FREE_TIER_DISPATCH=disabled
# Set true only after the account/data-use approval is independently confirmed.
UNDERSTOOD_GEMINI_PAID_ACCOUNT=false
# Select and evaluate the actual models; no synthetic model defaults are inherited.
UNDERSTOOD_GEMINI_TEXT_MODEL=
UNDERSTOOD_GEMINI_TRANSCRIPTION_MODEL=
UNDERSTOOD_GEMINI_SPEECH_MODEL=
UNDERSTOOD_GEMINI_VOICE=
# JSON arrays of evaluated locale codes, including en and every release language.
UNDERSTOOD_GEMINI_TEXT_LANGUAGES=[]
UNDERSTOOD_GEMINI_SPEECH_LANGUAGES=[]
UNDERSTOOD_RELEASE_CANDIDATE_FINGERPRINT=
UNDERSTOOD_RELEASE_APPROVAL_FILE=/run/understood/release-approval.json
# On Vercel, use UNDERSTOOD_RELEASE_APPROVAL_JSON instead and unset the file.
# Supply the same actually reviewed manifest; do not generate approval evidence.

# Company registration verification (separate from invitation/recovery mail).
UNDERSTOOD_REGISTRATION_PROVIDER=neon
UNDERSTOOD_NEON_AUTH_URL=

# API-only genuine malware scanning endpoint. Real files remain blocked if unset.
UNDERSTOOD_ATTACHMENT_SCANNER_URL=
UNDERSTOOD_ATTACHMENT_SCANNER_KEY=

# DeepL primary translation: only reviewed capabilities; no implicit fallback.
UNDERSTOOD_TRANSLATION_ADAPTER=deepl-v2
UNDERSTOOD_DEEPL_PAID_ACCOUNT=false
UNDERSTOOD_DEEPL_TEXT_LANGUAGES=[]
UNDERSTOOD_DEEPL_CAPABILITY_REFERENCE=
