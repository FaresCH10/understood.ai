# Overlay the API contract only in the separate worker service.
UNDERSTOOD_POSTGRES_URL=
UNDERSTOOD_POSTGRES_ROLE_PROFILE=worker
GEMINI_API_KEY=
# File scanning belongs to the API, never the queue worker.
UNDERSTOOD_ATTACHMENT_SCANNER_URL=
UNDERSTOOD_ATTACHMENT_SCANNER_KEY=

# Paid translator key stays only in the worker secret overlay.
DEEPL_API_KEY=
