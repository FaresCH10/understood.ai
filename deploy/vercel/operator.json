{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && node scripts/build-vercel-operator.mjs",
  "outputDirectory": "dist-operator",
  "functions": {"api/gateway.mjs": {"maxDuration": 30, "includeFiles": "server/postgres/migrations/*.sql"}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api/gateway?understood_path=:path*"}],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "Cache-Control", "value": "private, no-store"},
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
    {"key": "Referrer-Policy", "value": "no-referrer"},
    {"key": "Strict-Transport-Security", "value": "max-age=31536000"},
    {"key": "Permissions-Policy", "value": "microphone=(), camera=(), geolocation=()"},
    {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}
  ]}]
}
